	<nml_record name="tracer_forcing_dyeTracers">
		<nml_option name="config_use_dyeTracers" type="logical" default_value=".false." units="unitless"
			description="if true, the 'dyeGRP' category is enabled for the run"
			possible_values=".true. or .false."
		/>
		<nml_option name="config_use_dyeTracers_surface_bulk_forcing" type="logical" default_value=".false." units="unitless"
			description="if true, surface bulk forcing from coupler is added to surfaceTracerFlux in 'dyeGRP' category"
			possible_values=".true. or .false."
		/>
		<nml_option name="config_use_dyeTracers_surface_restoring" type="logical" default_value=".false." units="unitless"
			description="if true, surface restoring source is applied to tracers in 'dyeGRP' category"
			possible_values=".true. or .false."
		/>
		<nml_option name="config_use_dyeTracers_interior_restoring" type="logical" default_value=".false." units="unitless"
			description="if true, interior restoring source is applied to tracers in 'dyeGRP' category"
			possible_values=".true. or .false."
		/>
		<nml_option name="config_use_dyeTracers_exponential_decay" type="logical" default_value=".false." units="unitless"
			description="if true, exponential decay source is applied to tracers in 'dyeGRP' category"
			possible_values=".true. or .false."
		/>
		<nml_option name="config_use_dyeTracers_idealAge_forcing" type="logical" default_value=".false." units="unitless"
			description="if true, idealAge forcing source is applied to tracers in 'dyeGRP' category"
			possible_values=".true. or .false."
		/>
		<nml_option name="config_use_dyeTracers_ttd_forcing" type="logical" default_value=".false." units="unitless"
			description="if true, transit time distribution forcing source is applied to tracers in 'dyeGRP' category"
			possible_values=".true. or .false."
		/>
	</nml_record>

	<packages>
		<package name="dyeTracersPKG" description="This package includes variables required to include dyeGRP."/>
		<package name="dyeTracersBulkRestoringPKG" description="This package includes variables required to compute bulk restoring on the dye tracer group."/>
		<package name="dyeTracersSurfaceRestoringPKG" description="This package includes variables required to compute surface restoring on the dye tracer group."/>
		<package name="dyeTracersInteriorRestoringPKG" description="This package includes variables required to compute interior restoring on the dye tracer group."/>
		<package name="dyeTracersExponentialDecayPKG" description="This package includes variables required to compute exponential decay on the dye tracer group."/>
		<package name="dyeTracersIdealAgePKG" description="This package includes variables required to compute ideal age forcing on the dye tracer group."/>
		<package name="dyeTracersTTDPKG" description="This package includes variables required to compute transit-time distribution forcing on the dye tracer group."/>
	</packages>

	<var_struct name="state" time_levs="2">
		<var_struct name="tracers" time_levs="2">
			<var_array name="dyeTracers" dimensions="nVertLevels nCells Time" type="real" packages="dyeTracersPKG"  default_value="0.0">
				<!-- Add constituents of tracer group -->
				<var name="dyeVolBarents" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolBarents"
				/>
				<var name="dyeSaltBarents" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeSaltBarents"
				/>
				<var name="dyeVolBering" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolBering"
				/>
