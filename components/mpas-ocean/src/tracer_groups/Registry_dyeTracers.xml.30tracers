			description="dyeSaltBering"
				/>
				<var name="dyeVolFram" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolFram"
				/>
				<var name="dyeSaltFram" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeSaltFram"
				/>
				<var name="dyeVolDavis" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolDavis"
				/>
				<var name="dyeSaltDavis" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeSaltDavis"
				/>
				<var name="dyeVolFuryHecla" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolFuryHecla"
				/>
				<var name="dyeSaltFuryHecla" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeSaltFuryHecla"
				/>
				<var name="dyeVolMackenzie" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolMackenzie"
				/>
				<var name="dyeVolOb" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolOb"
				/>
				<var name="dyeVolYenesei" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolYenesei"
				/>
				<var name="dyeVolLena" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolLena"
				/>
				<var name="dyeVolPrecipEvap" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolPrecipEvap"
				/>
				<var name="dyeVolIceMeltForm" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolIceMeltForm"
				/>
				<var name="dyeVolKolyma" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolKolyma"
				/>
				<var name="dyeVolBarentsNS" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolBarentsNS"
				/>
				<var name="dyeVolBeringNS" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolBeringNS"
				/>
				<var name="dyeVolFramNS" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolFramNS"
				/>
				<var name="dyeVolDavisNS" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolDavisNS"
				/>
				<var name="dyeVolFuryHeclaNS" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolFuryHeclaNS"
				/>
				<var name="dyeVolMackenzieNS" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolMackenzieNS"
				/>
				<var name="dyeVolObNS" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolObNS"
				/>
				<var name="dyeVolYeneseiNS" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolYeneseiNS"
				/>
				<var name="dyeVolLenaNS" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolLenaNS"
				/>
				<var name="dyeVolYukonNS" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolYukonNS"
				/>
				<var name="dyeVolKolymaNS" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolKolymaNS"
				/>
				<var name="dyeVolPrecipEvapNS" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolPrecipEvapNS"
				/>
				<var name="dyeVolIceMeltFormNS" array_group="dyeGRP" units="kg m^{-3}"
			description="dyeVolIceMeltFormNS"
				/>
			</var_array>
		</var_struct>
